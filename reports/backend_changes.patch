+// Resolve every export path before starting worker threads. A new run must not
+// append poses to an older map or silently replace a completed map.
+inline void configureResultDirectory(const std::string &requested)
+{
+    if (requested.empty()) return; // Compatibility for existing callers.
+    const fs::path dir(requested);
+    if (!dir.is_absolute()) throw std::runtime_error("result_save/output_dir must be absolute");
+    if (fs::exists(dir) && !fs::is_empty(dir))
+        throw std::runtime_error("result_save/output_dir must be new or empty");
+    fs::create_directories(dir);
+    result_dir = dir.string() + "/";
+    scan_frames_dir = result_dir + "SCAN_FRAMES/";
+    imu_states_dir = result_dir + "IMU_STATES/";
+    keyframe_frames_dir = result_dir + "KEY_FRAMES/";
+    ikdtree_output_dir = result_dir + "TREE_CLOUDS/";
+}
