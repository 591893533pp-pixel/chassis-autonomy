Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: trial_map
    Background Color: 28; 30; 35
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
    - Class: rviz_default_plugins/RobotModel
      Name: Chassis CAD preview - anchor unverified
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
      Visual Enabled: true
    - Class: rviz_default_plugins/Polygon
      Name: Chassis envelope
      Enabled: true
      Topic:
        Value: /chassis/footprint
    - Class: rviz_default_plugins/PointCloud2
      Name: Optimized keyframe map
      Enabled: true
      Topic:
        Value: /lio_sam/mapping/cloud_global
      Size (m): 0.03
      Style: Points
    - Class: rviz_default_plugins/Path
      Name: Optimized path
      Enabled: true
      Topic:
        Value: /lio_sam/mapping/path
    - Class: rviz_default_plugins/MarkerArray
      Name: Loop edges
      Enabled: true
      Topic:
        Value: /lio_sam/loop_closure_constraints
    - Class: rviz_default_plugins/Map
      Name: Navigation map
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/Path
      Name: Planned path
      Enabled: true
      Topic:
        Value: /plan
    - Class: rviz_default_plugins/Polygon
      Name: Padded navigation footprint
      Enabled: true
      Topic:
        Value: /local_costmap/published_footprint
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetInitialPose
      Topic: /initialpose
    - Class: nav2_rviz_plugins/GoalTool
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 50
Window Geometry:
  Width: 1200
  Height: 850
